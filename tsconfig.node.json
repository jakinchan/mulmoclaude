{
  "compilerOptions": {
    "composite": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "strict": true,
    "useUnknownInCatchVariables": true,
    "noImplicitReturns": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true
  },
  // `vite.config.ts` alone left the modules it imports outside the project, so
  // they were type-checked by nothing (TS6307 the moment `strict` went on).
  "include": ["vite.config.ts", "scripts/lib/**/*.ts", "server/utils/envCoerce.ts"]
}
